# Generate src/server/assets_generated.cpp from everything in web/. Each file becomes a byte array; the
# server serves them from memory, so the whole web app ships inside the judas binary.
# Invoked with: cmake -DIN_DIR=.. -DOUT=.. -P embed_assets.cmake
file(GLOB_RECURSE assets RELATIVE "${IN_DIR}" "${IN_DIR}/*")
set(body "// generated from web/ by embed_assets.cmake; do not edit\n#include \"server/assets.h\"\nnamespace judas {\n")
set(entries "")
set(i 0)
foreach(a ${assets})
    file(READ "${IN_DIR}/${a}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
    string(APPEND body "static const unsigned char a${i}[] = {${arr}0x00};\n")
    set(mime "application/octet-stream")
    if(a MATCHES "\\.html$")
        set(mime "text/html; charset=utf-8")
    elseif(a MATCHES "\\.css$")
        set(mime "text/css; charset=utf-8")
    elseif(a MATCHES "\\.js$")
        set(mime "text/javascript; charset=utf-8")
    elseif(a MATCHES "\\.svg$")
        set(mime "image/svg+xml")
    elseif(a MATCHES "\\.json$")
        set(mime "application/json")
    elseif(a MATCHES "\\.png$")
        set(mime "image/png")
    elseif(a MATCHES "\\.woff2$")
        set(mime "font/woff2")
    endif()
    string(APPEND entries "  {\"/${a}\", \"${mime}\", a${i}, sizeof(a${i})-1},\n")
    math(EXPR i "${i}+1")
endforeach()
string(APPEND body "const Asset * assets_table(size_t & n) {\n  static const Asset t[] = {\n${entries}  };\n  n = sizeof(t)/sizeof(t[0]);\n  return t;\n}\n}\n")
file(WRITE "${OUT}" "${body}")
